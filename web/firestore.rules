rules_version = '2';

// PowrFit Firestore rules (Phase 2, P2-06; routines added in P4-01; legacy
// deletes in P5-05; profile and gyms in Phase 6). Every
// path is listed explicitly: rules are OR-ed together, so a catch-all like
// users/{uid}/{document=**} would let any write skip the validation below.
// Anything not matched here is denied. Tested in tests/rules with the emulator (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Mirrors decodeWorkoutLog in src/lib/workout/workout-codec.ts. Rules
    // can't loop over lists, so individual sets are checked by the app.
    function isValidWorkoutLog(logId) {
      let data = request.resource.data;
      let totals = data.totals;
      return data.keys().hasAll(['id', 'schemaVersion', 'startedAt', 'endedAt', 'updatedAt',
                                 'exercises', 'exerciseIds', 'totals'])
        && data.keys().hasOnly(['id', 'schemaVersion', 'routineId', 'routineName', 'startedAt',
                                'endedAt', 'updatedAt', 'exercises', 'exerciseIds', 'totals'])
        && data.id == logId
        && data.schemaVersion == 1
        && data.startedAt is string && data.startedAt.size() <= 40
        && data.endedAt is string && data.endedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('routineId' in data) || (data.routineId is string && data.routineId.size() <= 100))
        && (!('routineName' in data) || (data.routineName is string && data.routineName.size() <= 100))
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 30
        && data.exerciseIds is list && data.exerciseIds.size() >= 1 && data.exerciseIds.size() <= 30
        && totals is map
        && totals.keys().hasOnly(['sets', 'reps', 'volume', 'unit'])
        && totals.sets is int && totals.sets >= 0
        && totals.reps is int && totals.reps >= 0
        && totals.volume is number && totals.volume >= 0
        && totals.unit in ['kg', 'lb'];
    }

    // Mirrors routineProblems in src/lib/strength/routines.ts (D21) and
    // decodeRoutine in src/lib/workout/routine-codec.ts.
    function isValidRoutine(routineId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'schemaVersion', 'name', 'exercises', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'schemaVersion', 'name', 'notes', 'exercises', 'createdAt',
                                'updatedAt'])
        && data.id == routineId
        && data.schemaVersion == 1
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 30
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // The user's own routines (P4-01). Presets ship with the app.
    match /users/{userId}/routines/{routineId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidRoutine(routineId);
    }

    // Finished workouts. A retry rewrites the same document (same id).
    match /users/{userId}/workoutLogs/{logId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidWorkoutLog(logId);
    }

    // Mirrors decodeProfile in src/lib/profile.ts (P6-12, D41). The avatar
    // has no photo kind: profile photos aren't stored.
    function isValidProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['displayName', 'avatar', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'avatar', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.avatar is map
        && data.avatar.keys().hasOnly(['kind', 'color'])
        && data.avatar.kind == 'initials'
        && data.avatar.color in ['yellow', 'green', 'blue', 'pink', 'orange', 'purple']
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // Display name and avatar (P6-12).
    match /users/{userId}/settings/profile {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile();
    }

    // The kg/lb preference.
    match /users/{userId}/settings/preferences {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['weightUnit'])
        && request.resource.data.weightUnit in ['kg', 'lb'];
    }

    // Gym prices you approved (P6-04, D36): shared, read-only for signed-in
    // users. Only you write them, by hand in the Firebase console, which
    // bypasses these rules. No listing: the app reads gyms by id.
    match /gyms/{placeId} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    // Users' price reports (P6-04, D42): signed-in users can send one;
    // nobody can read, change or delete them through the app. Anonymous:
    // no user id is stored. Mirrors priceReportProblems in src/lib/gyms.
    match /gymPriceReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['placeId', 'gymName', 'plan', 'monthlyPrice', 'currency', 'createdAt'])
        && request.resource.data.keys().hasAll(['placeId', 'gymName', 'plan', 'monthlyPrice', 'currency', 'createdAt'])
        && request.resource.data.placeId is string
        && request.resource.data.placeId.matches('osm-(node|way|relation)-[0-9]{1,20}')
        && request.resource.data.gymName is string && request.resource.data.gymName.size() <= 100
        && request.resource.data.plan is string
        && request.resource.data.plan.size() >= 1 && request.resource.data.plan.size() <= 60
        && request.resource.data.monthlyPrice is number
        && request.resource.data.monthlyPrice > 0 && request.resource.data.monthlyPrice <= 1000
        && request.resource.data.currency in ['USD', 'CAD', 'GBP', 'EUR', 'AUD']
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow read, update, delete: if false;
    }

    // Phase 0 mock data, retired in P2-15: owners can still read it and
    // delete it (Delete account, P5-05), nobody can write it.
    match /users/{userId}/{legacy}/{docId} {
      allow read, delete: if isOwner(userId)
        && legacy in ['dashboard', 'goals', 'upcomingSessions', 'workoutSessions'];
    }
  }
}
